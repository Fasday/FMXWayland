/// <summary>Binding of libwayland-client (loaded with dlopen at run time, so programs start without it and can say
/// what is missing): the core types (wl_interface, wl_message, wl_argument, wl_array, wl_fixed_t), the display and
/// the proxy functions. The protocol units (src\Protocols, generated by tools\gen-wayland.ps1) build on it.</summary>
unit FMXWayland.Wayland;

interface

type
  /// <summary>Opaque struct wl_proxy.</summary>
  Twl_proxy = record
  end;
  Pwl_proxy = ^Twl_proxy;
  /// <summary>Opaque struct wl_display (also a wl_proxy).</summary>
  Twl_display = record
  end;
  Pwl_display = ^Twl_display;
  /// <summary>Opaque struct wl_event_queue.</summary>
  Twl_event_queue = record
  end;
  Pwl_event_queue = ^Twl_event_queue;

  Pwl_interface = ^Twl_interface;
  PPwl_interface = ^Pwl_interface;

  /// <summary>struct wl_message: a request or an event of an interface.</summary>
  Twl_message = record
    name: PAnsiChar;
    signature: PAnsiChar;
    types: PPwl_interface;
  end;
  Pwl_message = ^Twl_message;

  /// <summary>struct wl_interface: the protocol description of an interface.</summary>
  Twl_interface = record
    name: PAnsiChar;
    version: Integer;
    method_count: Integer;
    methods: Pwl_message;
    event_count: Integer;
    events: Pwl_message;
  end;

  /// <summary>struct wl_array.</summary>
  Twl_array = record
    size: NativeUInt;
    alloc: NativeUInt;
    data: Pointer;
  end;
  Pwl_array = ^Twl_array;

  /// <summary>wl_fixed_t: signed 24.8 fixed-point number.</summary>
  Twl_fixed = Int32;

  /// <summary>union wl_argument (8 bytes).</summary>
  Twl_argument = record
    case Integer of
      0: (i: Int32);
      1: (u: UInt32);
      2: (f: Twl_fixed);
      3: (s: PAnsiChar);
      4: (o: Pointer);
      5: (n: UInt32);
      6: (a: Pwl_array);
      7: (h: Int32);
      8: (raw: UInt64);
  end;
  Pwl_argument = ^Twl_argument;

const
  /// <summary>WL_MARSHAL_FLAG_DESTROY: the request destroys the proxy.</summary>
  WL_MARSHAL_FLAG_DESTROY = 1;

var
  wl_display_connect: function(AName: PAnsiChar): Pwl_display; cdecl;
  wl_display_connect_to_fd: function(AFd: Integer): Pwl_display; cdecl;
  wl_display_disconnect: procedure(ADisplay: Pwl_display); cdecl;
  wl_display_get_fd: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_dispatch: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_dispatch_pending: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_dispatch_queue_pending: function(ADisplay: Pwl_display; AQueue: Pwl_event_queue): Integer; cdecl;
  wl_display_roundtrip: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_roundtrip_queue: function(ADisplay: Pwl_display; AQueue: Pwl_event_queue): Integer; cdecl;
  wl_display_flush: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_prepare_read: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_read_events: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_cancel_read: procedure(ADisplay: Pwl_display); cdecl;
  wl_display_get_error: function(ADisplay: Pwl_display): Integer; cdecl;
  wl_display_get_protocol_error: function(ADisplay: Pwl_display; var AInterface: Pwl_interface;
    var AId: UInt32): UInt32; cdecl;
  wl_display_create_queue: function(ADisplay: Pwl_display): Pwl_event_queue; cdecl;
  wl_event_queue_destroy: procedure(AQueue: Pwl_event_queue); cdecl;

  wl_proxy_marshal_array_flags: function(AProxy: Pwl_proxy; AOpcode: UInt32; AInterface: Pwl_interface;
    AVersion: UInt32; AFlags: UInt32; AArgs: Pwl_argument): Pwl_proxy; cdecl;
  wl_proxy_marshal_array_constructor_versioned: function(AProxy: Pwl_proxy; AOpcode: UInt32; AArgs: Pwl_argument;
    AInterface: Pwl_interface; AVersion: UInt32): Pwl_proxy; cdecl;
  wl_proxy_marshal_array: procedure(AProxy: Pwl_proxy; AOpcode: UInt32; AArgs: Pwl_argument); cdecl;
  wl_proxy_destroy: procedure(AProxy: Pwl_proxy); cdecl;
  wl_proxy_add_listener: function(AProxy: Pwl_proxy; AImplementation: Pointer; AData: Pointer): Integer; cdecl;
  wl_proxy_get_listener: function(AProxy: Pwl_proxy): Pointer; cdecl;
  wl_proxy_set_user_data: procedure(AProxy: Pwl_proxy; AData: Pointer); cdecl;
  wl_proxy_get_user_data: function(AProxy: Pwl_proxy): Pointer; cdecl;
  wl_proxy_get_version: function(AProxy: Pwl_proxy): UInt32; cdecl;
  wl_proxy_get_id: function(AProxy: Pwl_proxy): UInt32; cdecl;
  wl_proxy_get_class: function(AProxy: Pwl_proxy): PAnsiChar; cdecl;
  wl_proxy_set_queue: procedure(AProxy: Pwl_proxy; AQueue: Pwl_event_queue); cdecl;
  wl_proxy_create_wrapper: function(AProxy: Pointer): Pointer; cdecl;
  wl_proxy_wrapper_destroy: procedure(AWrapper: Pointer); cdecl;

/// <summary>Loads libwayland-client.so.0 (once). False with AError = what is missing.</summary>
function LoadWaylandClient(out AError: string): Boolean;
/// <summary>True after a successful LoadWaylandClient.</summary>
function WaylandClientLoaded: Boolean;

/// <summary>Sends a request (what wl_proxy_marshal_flags does in C, through the array variant): AInterface/AVersion
/// for the object a new_id argument creates (nil if none), AFlags = WL_MARSHAL_FLAG_DESTROY for destructors. Falls
/// back to the older wl_proxy_marshal_array_constructor_versioned on libwayland before 1.20.</summary>
function WlProxyMarshalFlags(AProxy: Pwl_proxy; AOpcode: UInt32; AInterface: Pwl_interface; AVersion: UInt32;
  AFlags: UInt32; AArgs: Pwl_argument): Pwl_proxy;

/// <summary>wl_fixed_t to Double.</summary>
function wl_fixed_to_double(AValue: Twl_fixed): Double; inline;
/// <summary>Double to wl_fixed_t.</summary>
function wl_fixed_from_double(AValue: Double): Twl_fixed; inline;
/// <summary>Integer to wl_fixed_t.</summary>
function wl_fixed_from_int(AValue: Integer): Twl_fixed; inline;

implementation

uses
  System.SysUtils, Posix.Dlfcn;

var
  GHandle: NativeUInt = 0;
  GLoaded: Boolean = False;

function WaylandClientLoaded: Boolean;
begin
  Result := GLoaded;
end;

function LoadWaylandClient(out AError: string): Boolean;
var
  Missing: string;

  function Sym(const AName: string; ARequired: Boolean = True): Pointer;
  var
    M: TMarshaller;
  begin
    Result := dlsym(GHandle, M.AsAnsi(AName).ToPointer);
    if (Result = nil) and ARequired then
      Missing := Missing + ' ' + AName;
  end;

var
  M: TMarshaller;
begin
  AError := '';
  if GLoaded then
    Exit(True);
  if GHandle = 0 then
    GHandle := dlopen(M.AsAnsi('libwayland-client.so.0').ToPointer, RTLD_NOW);
  if GHandle = 0 then
  begin
    AError := 'cannot load libwayland-client.so.0 (' + string(UTF8String(dlerror)) +
      '); install the package libwayland-client0';
    Exit(False);
  end;
  Missing := '';
  wl_display_connect := Sym('wl_display_connect');
  wl_display_connect_to_fd := Sym('wl_display_connect_to_fd');
  wl_display_disconnect := Sym('wl_display_disconnect');
  wl_display_get_fd := Sym('wl_display_get_fd');
  wl_display_dispatch := Sym('wl_display_dispatch');
  wl_display_dispatch_pending := Sym('wl_display_dispatch_pending');
  wl_display_dispatch_queue_pending := Sym('wl_display_dispatch_queue_pending');
  wl_display_roundtrip := Sym('wl_display_roundtrip');
  wl_display_roundtrip_queue := Sym('wl_display_roundtrip_queue');
  wl_display_flush := Sym('wl_display_flush');
  wl_display_prepare_read := Sym('wl_display_prepare_read');
  wl_display_read_events := Sym('wl_display_read_events');
  wl_display_cancel_read := Sym('wl_display_cancel_read');
  wl_display_get_error := Sym('wl_display_get_error');
  wl_display_get_protocol_error := Sym('wl_display_get_protocol_error', False);
  wl_display_create_queue := Sym('wl_display_create_queue');
  wl_event_queue_destroy := Sym('wl_event_queue_destroy');
  wl_proxy_marshal_array_flags := Sym('wl_proxy_marshal_array_flags', False);
  wl_proxy_marshal_array_constructor_versioned := Sym('wl_proxy_marshal_array_constructor_versioned');
  wl_proxy_marshal_array := Sym('wl_proxy_marshal_array');
  wl_proxy_destroy := Sym('wl_proxy_destroy');
  wl_proxy_add_listener := Sym('wl_proxy_add_listener');
  wl_proxy_get_listener := Sym('wl_proxy_get_listener');
  wl_proxy_set_user_data := Sym('wl_proxy_set_user_data');
  wl_proxy_get_user_data := Sym('wl_proxy_get_user_data');
  wl_proxy_get_version := Sym('wl_proxy_get_version');
  wl_proxy_get_id := Sym('wl_proxy_get_id');
  wl_proxy_get_class := Sym('wl_proxy_get_class');
  wl_proxy_set_queue := Sym('wl_proxy_set_queue');
  wl_proxy_create_wrapper := Sym('wl_proxy_create_wrapper', False);
  wl_proxy_wrapper_destroy := Sym('wl_proxy_wrapper_destroy', False);
  if Missing <> '' then
  begin
    AError := 'libwayland-client.so.0 lacks:' + Missing + ' (libwayland 1.15 or newer is needed)';
    Exit(False);
  end;
  GLoaded := True;
  Result := True;
end;

function WlProxyMarshalFlags(AProxy: Pwl_proxy; AOpcode: UInt32; AInterface: Pwl_interface; AVersion: UInt32;
  AFlags: UInt32; AArgs: Pwl_argument): Pwl_proxy;
begin
  if Assigned(wl_proxy_marshal_array_flags) then
    Exit(wl_proxy_marshal_array_flags(AProxy, AOpcode, AInterface, AVersion, AFlags, AArgs));
  if AInterface <> nil then
    Result := wl_proxy_marshal_array_constructor_versioned(AProxy, AOpcode, AArgs, AInterface, AVersion)
  else
  begin
    wl_proxy_marshal_array(AProxy, AOpcode, AArgs);
    Result := nil;
  end;
  if AFlags and WL_MARSHAL_FLAG_DESTROY <> 0 then
    wl_proxy_destroy(AProxy);
end;

function wl_fixed_to_double(AValue: Twl_fixed): Double;
begin
  Result := AValue / 256;
end;

function wl_fixed_from_double(AValue: Double): Twl_fixed;
begin
  Result := Round(AValue * 256);
end;

function wl_fixed_from_int(AValue: Integer): Twl_fixed;
begin
  Result := AValue * 256;
end;

end.
