* text=auto

# Delphi sources and scripts: CRLF (the IDE and the compiler expect it)
*.pas     text eol=crlf
*.dpr     text eol=crlf
*.dpk     text eol=crlf
*.dproj   text eol=crlf
*.groupproj text eol=crlf
*.inc     text eol=crlf
*.fmx     text eol=crlf
*.ps1     text eol=crlf
*.bat     text eol=crlf
*.cmd     text eol=crlf

# Documentation and protocol descriptions: LF
*.md      text eol=lf
*.xml     text eol=lf
*.sh      text eol=lf

*.res     binary
*.png     binary
*.ico     binary
